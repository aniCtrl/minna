rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------
    // ROOMS
    // -----------------------------------------

    match /rooms/{roomCode} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == "lobby"
        && request.resource.data.matchMode in ["strict", "majority"];

      allow update: if request.auth != null
        && (

          // -----------------------------------------
          // NORMAL HOST ACTIONS
          // -----------------------------------------

          (
            request.auth.uid == resource.data.hostUid
            &&
            request.resource.data.hostUid == resource.data.hostUid
            &&
            request.resource.data.matchMode == resource.data.matchMode
            &&
            (
              // lobby or movie_selection -> voting
              (
                (
                  resource.data.status == "lobby"
                  ||
                  resource.data.status == "movie_selection"
                )
                &&
                request.resource.data.status == "voting"
              )

              ||

              // voting -> results
              (
                resource.data.status == "voting"
                &&
                request.resource.data.status == "results"
              )

              ||

              // host -> closed
              (
                request.resource.data.status == "closed"
                &&
                (
                  resource.data.status == "lobby"
                  ||
                  resource.data.status == "movie_selection"
                  ||
                  resource.data.status == "voting"
                  ||
                  resource.data.status == "results"
                )
              )
            )
          )

          ||

          // -----------------------------------------
          // JOIN ROOM
          // -----------------------------------------

          (
            resource.data.status == "lobby"
            &&
            request.resource.data.status == resource.data.status
            &&
            request.resource.data.hostUid == resource.data.hostUid
            &&
            request.resource.data.members.diff(resource.data.members)
              .affectedKeys()
              .hasOnly([request.auth.uid])
            &&
            request.resource.data.members[request.auth.uid] != null
          )

          ||

          // -----------------------------------------
          // CLAIM HOST
          // -----------------------------------------

          (
            request.resource.data.hostUid == request.auth.uid
            &&
            request.resource.data.status == resource.data.status
            &&
            !exists(
              /databases/$(database)/documents/rooms/$(roomCode)/members/$(resource.data.hostUid)
            )
            &&
            exists(
              /databases/$(database)/documents/rooms/$(roomCode)/members/$(request.auth.uid)
            )
          )
        );
    }


    // -----------------------------------------
    // MEMBERS
    // -----------------------------------------

    match /rooms/{roomCode}/members/{memberUid} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == memberUid;

      allow update, delete: if false;
    }


    // -----------------------------------------
    // MOVIES
    // -----------------------------------------

    match /rooms/{roomCode}/movies/{movieId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
        && (
          get(/databases/$(database)/documents/rooms/$(roomCode)).data.status == "lobby"
          ||
          get(/databases/$(database)/documents/rooms/$(roomCode)).data.status == "movie_selection"
        )
        && get(
          /databases/$(database)/documents/rooms/$(roomCode)
        ).data.members[request.auth.uid] != null;

      allow delete: if request.auth != null
        && get(
          /databases/$(database)/documents/rooms/$(roomCode)
        ).data.hostUid == request.auth.uid
        && (
          get(/databases/$(database)/documents/rooms/$(roomCode)).data.status == "lobby"
          ||
          get(/databases/$(database)/documents/rooms/$(roomCode)).data.status == "movie_selection"
        );
    }


    // -----------------------------------------
    // VOTES
    // -----------------------------------------

    match /rooms/{roomCode}/votes/{voteId} {

      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid;

      allow delete: if false;
    }


    // -----------------------------------------
    // DEFAULT DENY
    // -----------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}